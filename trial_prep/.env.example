# Copy this file to .env and fill in your key. .env is gitignored.

# Which provider to use: "huggingface" (default) or "openai".
MODEL_PROVIDER=huggingface

# --- huggingface ---
# HF user access token (Settings -> Access Tokens on huggingface.co).
# Uses HF's OpenAI-compatible router, so a vision-capable model is required
# for the OCR stage. Default model can be overridden with TRIAL_PREP_MODEL.
HF_API_TOKEN=hf_...

# --- openai ---
# Only needed if MODEL_PROVIDER=openai.
OPENAI_API_KEY=sk-...

# Optional overrides
TRIAL_PREP_MODEL=prism-ml/Ternary-Bonsai-27B-AWQ-4bit
OCR_CONFIDENCE_THRESHOLD=0.75
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
